extends RefCounted # Provides a lightweight owner for the embedded jump sprite sheet data.
class_name TornJumpTextureData # Gives the jump texture loader a strongly typed project-wide class name.

const PNG_BASE64: String = "" # Stores the optimized transparent jump sprite sheet without requiring a binary GitHub write.

static var _texture_cache: Texture2D = null # Caches the decoded texture so the PNG is expanded only once per process.

static func get_texture() -> Texture2D: # Returns the cached jump texture and lazily builds it on first use.
	if _texture_cache != null: # Avoids repeating Base64 decoding and PNG decompression for additional player visuals.
		return _texture_cache # Reuses the already-created GPU texture resource.
	var png_bytes: PackedByteArray = Marshalls.base64_to_raw(PNG_BASE64) # Decodes the embedded PNG payload into binary image bytes.
	var image: Image = Image.new() # Creates the CPU-side image that will receive the decoded PNG pixels.
	var load_error: int = image.load_png_from_buffer(png_bytes) # Loads the PNG directly from memory so exported builds do not depend on external file access.
	assert(load_error == OK, "Failed to decode the embedded player jump sprite sheet.") # Stops debug builds immediately if the committed sprite data is damaged.
	_texture_cache = ImageTexture.create_from_image(image) # Uploads the decoded image once as a reusable Texture2D resource.
	return _texture_cache # Supplies the cached jump texture to the visual component.
